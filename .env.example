PORT=8092
APP_BASE_URL=https://query.example.com
TZ=Asia/Shanghai
DOCKER_SUBNET=172.16.240.0/24

# trusted_headers: production behind Authelia/Nginx; dev: local development only
AUTH_MODE=trusted_headers
AUTH_TRUSTED_PROXY_HEADER=x-auth-proxy-token
AUTH_TRUSTED_PROXY_TOKEN=replace-with-another-long-random-key
REMOTE_USER_HEADER=remote-user
REMOTE_NAME_HEADER=remote-name
REMOTE_EMAIL_HEADER=remote-email
REMOTE_KINGDEE_USERNAME_HEADER=remote-kingdee-username
KINGDEE_USERNAME_SOURCE=auto
KINGDEE_QUERY_SCOPE_ADMINS=

# Local super-admin login. Accounts and module access lists are stored as
# password hashes in /app/data/access-control.json. Set cookie secure=true
# when APP_BASE_URL is HTTPS.
LOCAL_AUTH_DATA_PATH=/app/data/access-control.json
LOCAL_AUTH_SESSION_HOURS=8
LOCAL_AUTH_COOKIE_SECURE=false

# Optional passwordless login for local super-admin accounts. Passkey requires
# an HTTPS origin (localhost is also allowed for local development).
PASSKEY_ENABLED=true
PASSKEY_ORIGIN=https://query.example.com
PASSKEY_RP_ID=query.example.com
PASSKEY_RP_NAME=Kingdee Query Hub

# Comma separated bearer keys used by Dify. Generate at least 32 random bytes.
DIFY_API_KEYS=replace-with-a-long-random-key
DIFY_USER_HEADER=x-end-user

# Kingdee K3Cloud WebAPI
KINGDEE_BASE_URL=https://kingdee.example.com/K3Cloud/
KINGDEE_DBID=replace-me
KINGDEE_APP_ID=replace-me
KINGDEE_APP_SECRET=replace-me
KINGDEE_LCID=2052
KINGDEE_LOGIN_MODE=app_secret
KINGDEE_TIMEOUT_MS=15000
KINGDEE_REPORT_TIMEOUT_MS=120000
KINGDEE_SESSION_TTL_SECONDS=900
KINGDEE_MAX_ROWS=200
KINGDEE_QUERY_PAGE_SIZE=5000
KINGDEE_AGGREGATION_MAX_ROWS=5000

# Optional OpenAI-compatible model for web natural-language planning.
# Without these values, the built-in deterministic parser still supports common queries.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000

# Optional DeepSeek/OpenAI-compatible model for the read-only AI analysis panel.
# Keep this disabled until the data-transfer policy and API account are approved.
# Specific analysis values take precedence; blank values fall back to AI_BASE_URL,
# AI_API_KEY and AI_MODEL above.
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_BASE_URL=https://api.deepseek.com
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=deepseek-v4-flash
AI_ANALYSIS_TIMEOUT_MS=30000
AI_ANALYSIS_MAX_TOKENS=2500
AI_ANALYSIS_TOP_ROWS=40
AI_ANALYSIS_DETAIL_ROWS=300
AI_ANALYSIS_REDACT_IDENTIFIERS=true
AI_ANALYSIS_CACHE_TTL_SECONDS=600
AI_ANALYSIS_CONTEXT_TTL_SECONDS=600
AI_ANALYSIS_MAX_CONTEXTS=100
AI_ANALYSIS_RATE_LIMIT=5
AI_ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=600

# Deployment-only values used to render deploy/npm-advanced.conf.template.
# They are not read by the Node.js application.
AUTHELIA_URL=https://auth.example.com
APP_UPSTREAM=http://127.0.0.1:8092

LOG_LEVEL=info
AUDIT_LOG_PATH=/app/data/audit.ndjson
AUDIT_MAX_BYTES=10485760
AUDIT_MAX_FILES=10
TRUST_PROXY=true

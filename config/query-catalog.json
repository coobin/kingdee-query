{
  "inventory": {
    "label": "即时库存",
    "description": "按物料、仓库和库存组织查询即时库存",
    "formId": "STK_Inventory",
    "fields": [
      ["FStockOrgId.FNumber", "库存组织编码"],
      ["FStockOrgId.FName", "库存组织"],
      ["FMaterialId.FNumber", "物料编码"],
      ["FMaterialId.FName", "物料名称"],
      ["FStockId.FNumber", "仓库编码"],
      ["FStockId.FName", "仓库"],
      ["FLot.FNumber", "批号"],
      ["FBaseQty", "基本库存数量"],
      ["FSecQty", "辅助库存数量"],
      ["FProduceDate", "生产日期"],
      ["FExpiryDate", "有效期至"]
    ],
    "filterFields": {
      "materialNumber": "FMaterialId.FNumber",
      "materialName": "FMaterialId.FName",
      "warehouseNumber": "FStockId.FNumber",
      "warehouseName": "FStockId.FName",
      "organizationNumber": "FStockOrgId.FNumber",
      "lotNumber": "FLot.FNumber"
    },
    "defaultOrder": "FMaterialId.FNumber ASC",
    "requiresFilter": true
  },
  "sales_orders": {
    "label": "销售订单",
    "description": "查询销售订单编号、客户、组织、金额和状态",
    "formId": "SAL_SaleOrder",
    "fields": [
      ["FBillNo", "单据编号"],
      ["FDate", "业务日期"],
      ["FSaleOrgId.FName", "销售组织"],
      ["FCustId.FName", "客户"],
      ["FDocumentStatus", "审核状态"],
      ["FCloseStatus", "关闭状态"],
      ["FBillAllAmount", "价税合计"],
      ["FCreatorId.FName", "创建人"]
    ],
    "filterFields": {
      "billNumber": "FBillNo",
      "customerNumber": "FCustId.FNumber",
      "customerName": "FCustId.FName",
      "organizationName": "FSaleOrgId.FName",
      "creatorName": "FCreatorId.FName",
      "dateFrom": "FDate",
      "dateTo": "FDate"
    },
    "defaultOrder": "FDate DESC,FBillNo DESC",
    "valueMappings": {
      "审核状态": {
        "Z": "暂存",
        "A": "已创建",
        "B": "审核中",
        "C": "已审核",
        "D": "重新审核"
      }
    },
    "requiresFilter": true
  },
  "overdue_receivables": {
    "label": "超期未回款",
    "description": "按销售子项目统计开票后超过指定天数的未回款、未核销和未生成应收金额",
    "formId": "AR_RECEIVABLE",
    "queryType": "overdue_receivables",
    "fields": [
      ["FID", "应收内码"],
      ["FBillNo", "应收单号"],
      ["FCustomerID.FName", "客户"],
      ["FSettleOrgId.FName", "结算组织"],
      ["FSaleDeptId.FName", "销售部门"],
      ["F_PARA_SaleSubProId.FNumber", "销售子项目编码"],
      ["F_PARA_SaleSubProId.FName", "销售子项目名称"],
      ["FIVALLAMOUNTFOR", "已开票金额"],
      ["FRECEIVEAMOUNT", "已收金额"],
      ["FNORECEIVEAMOUNT", "未收金额"],
      ["FWRITTENOFFAMOUNT", "已核销金额"]
    ],
    "invoiceDateSource": {
      "formId": "IV_SALESIC",
      "fields": [
        ["FBillNo", "销售发票号"],
        ["FINVOICEDATE", "开票日期"],
        ["F_PARA_SaleSubProId.FNumber", "销售子项目编码"],
        ["F_PARA_SaleSubProId.FName", "销售子项目名称"],
        ["FCustomerID.FName", "客户"],
        ["FALLAMOUNTFOR", "发票金额"],
        ["FRedBlue", "红蓝字标识"]
      ],
      "defaultOrder": "FINVOICEDATE ASC,FBillNo ASC"
    },
    "receiptSource": {
      "formId": "AR_RECEIVEBILL",
      "fields": [
        ["FID", "收款内码"],
        ["FBillNo", "收款单号"],
        ["FDATE", "收款日期"],
        ["F_PARA_SaleSubProId.FNumber", "销售子项目编码"],
        ["F_PARA_SaleSubProId.FName", "销售子项目名称"],
        ["FRECAMOUNT", "收款金额"]
      ],
      "defaultOrder": "FDATE ASC,FBillNo ASC"
    },
    "refundSource": {
      "formId": "AR_REFUNDBILL",
      "fields": [
        ["FID", "退款内码"],
        ["FBillNo", "退款单号"],
        ["FDATE", "退款日期"],
        ["F_PARA_SaleSubProId.FNumber", "销售子项目编码"],
        ["F_PARA_SaleSubProId.FName", "销售子项目名称"],
        ["FREFUNDTOTALAMOUNTFOR", "退款金额"]
      ],
      "defaultOrder": "FDATE ASC,FBillNo ASC"
    },
    "publicColumns": [
      "客户",
      "销售子项目编码",
      "销售子项目名称",
      "开票日期",
      "超期天数",
      "超期发票数",
      "应收单数",
      "开票金额",
      "实际回款净额",
      "未核销金额",
      "未生成应收金额",
      "未回款金额",
      "回款状态"
    ],
    "filterFields": {
      "minimumDays": "FINVOICEDATE",
      "customerName": "FCustomerID.FName",
      "subprojectNumber": "F_PARA_SaleSubProId.FNumber"
    },
    "defaultOrder": "F_PARA_SaleSubProId.FNumber ASC,FBillNo ASC"
  },
  "purchase_orders": {
    "label": "采购订单",
    "description": "查询采购订单编号、供应商、组织、金额和状态",
    "formId": "PUR_PurchaseOrder",
    "fields": [
      ["FBillNo", "单据编号"],
      ["FDate", "业务日期"],
      ["FPurchaseOrgId.FName", "采购组织"],
      ["FSupplierId.FNumber", "供应商编码"],
      ["FSupplierId.FName", "供应商"],
      ["FDocumentStatus", "审核状态"],
      ["FCloseStatus", "关闭状态"],
      ["FBillAllAmount", "价税合计"],
      ["FCreatorId.FName", "创建人"]
    ],
    "filterFields": {
      "billNumber": "FBillNo",
      "supplierNumber": "FSupplierId.FNumber",
      "supplierName": "FSupplierId.FName",
      "organizationName": "FPurchaseOrgId.FName",
      "creatorName": "FCreatorId.FName",
      "dateFrom": "FDate",
      "dateTo": "FDate"
    },
    "defaultOrder": "FDate DESC,FBillNo DESC",
    "valueMappings": {
      "审核状态": {
        "Z": "暂存",
        "A": "已创建",
        "B": "审核中",
        "C": "已审核",
        "D": "重新审核"
      }
    },
    "requiresFilter": true
  },
  "expense_claims": {
    "label": "费用报销单",
    "description": "查询本人或授权范围内的费用报销单",
    "formId": "ER_ExpReimbursement",
    "fields": [
      ["FBillNo", "单据编号"],
      ["FDate", "申请日期"],
      ["FProposerID.FName", "申请人"],
      ["FRequestDeptID.FName", "申请部门"],
      ["FOrgID.FName", "申请组织"],
      ["FDocumentStatus", "审核状态"],
      ["FExpAmountSum", "单据总金额"],
      ["FApproveDate", "审核日期"]
    ],
    "filterFields": {
      "billNumber": "FBillNo",
      "applicantNumber": "FProposerID.FNumber",
      "applicantName": "FProposerID.FName",
      "departmentName": "FRequestDeptID.FName",
      "organizationName": "FOrgID.FName",
      "dateFrom": "FDate",
      "dateTo": "FDate",
      "status": "FDocumentStatus"
    },
    "selfField": "FProposerID.FName",
    "selfValueSource": "name",
    "defaultOrder": "FDate DESC,FBillNo DESC",
    "valueMappings": {
      "审核状态": {
        "Z": "暂存",
        "A": "已创建",
        "B": "审核中",
        "C": "已审核",
        "D": "重新审核"
      }
    },
    "requiresFilter": true,
    "forceSelfScope": true
  }
}
